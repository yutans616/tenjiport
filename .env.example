# Supabase（Project Settings > API から取得）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サービスロールキーはサーバー専用。クライアントに絶対に露出させない。
SUPABASE_SERVICE_ROLE_KEY=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Stripe（テストモードのキーを使用。本番課金は価格確定後に切り替える）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# アプリの公開URL（メール内リンク生成に使用）
NEXT_PUBLIC_APP_URL=http://localhost:3000

# /api/notifications/process を保護する共有シークレット（本番のCronから呼ぶ際に設定。未設定時はローカル開発用に無認証で許可）
CRON_SECRET=
